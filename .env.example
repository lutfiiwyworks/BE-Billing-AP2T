# Oracle
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_OFFICE_HOST=your_oracle_host
ORACLE_OFFICE_PORT=1521
ORACLE_OFFICE_SERVICE=your_service_name
ORACLE_VPN_HOST=your_oracle_host
ORACLE_VPN_PORT=1597
ORACLE_VPN_SERVICE=your_service_name
ORACLE_TRUNO_HOST=your_oracle_host
ORACLE_TRUNO_PORT=1597
ORACLE_TRUNO_SERVICE=your_service_name

# PostgreSQL LJB1
PG_LJB1_USER=your_postgres_user
PG_LJB1_PASSWORD=your_postgres_password
PG_LJB1_HOST=your_postgres_host
PG_LJB1_DATABASE=your_postgres_database
PG_LJB1_PORT=5488

# PostgreSQL Jateng
PG_JTG_USER=your_postgres_user
PG_JTG_PASSWORD=your_postgres_password
PG_JTG_HOST=your_postgres_host
PG_JTG_DATABASE=your_jateng_database
PG_JTG_PORT=5488

JWT_SECRET=replace_with_a_strong_secret
